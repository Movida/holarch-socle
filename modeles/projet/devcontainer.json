{
  "name": "{{nom}}",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": ["anthropic.claude-code"]
    }
  },
  // Rien de l'hôte qui porte un identifiant : Claude Code, ~/.ssh et la configuration de gh dans des volumes nommés
  // propres au projet. La connexion Claude s'y fait une fois et survit aux reconstructions (CLAUDE_CONFIG_DIR y met aussi
  // .claude.json, comme le conseille Anthropic) ; une clé de déploiement propre à ce dépôt (deploy-key.sh) ne donnerait
  // accès qu'à lui. De l'hôte, seulement : les transcriptions et la mémoire de ce projet (HOLARCH les lit), et les
  // règles du compte en lecture ; initializeCommand crée ces deux dossiers sur l'hôte s'ils manquent.
  "initializeCommand": "mkdir -p ${localEnv:HOME}/.claude/projects/{{dossier_claude}} ${localEnv:HOME}/.claude/rules",
  "mounts": [
    "source={{volume}}-claude,target=/home/vscode/.claude,type=volume",
    "source=${localEnv:HOME}/.claude/projects/{{dossier_claude}},target=/home/vscode/.claude/projects/{{dossier_claude}},type=bind",
    "source=${localEnv:HOME}/.claude/rules,target=/home/vscode/.claude/rules,type=bind,readonly",
    "source={{volume}}-ssh,target=/home/vscode/.ssh,type=volume",
    "source={{volume}}-gh-config,target=/home/vscode/.config/gh,type=volume"
  ],
  "containerEnv": { "CLAUDE_CONFIG_DIR": "/home/vscode/.claude" },
  // Un volume neuf appartient à root : il est rendu à l'utilisateur avant tout.
  "postCreateCommand": "sudo chown vscode:vscode /home/vscode/.claude /home/vscode/.claude/projects && (bash .devcontainer/deploy-key.sh origin || true)",
  "remoteUser": "vscode"
}
