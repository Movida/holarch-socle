{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Movida/holarch-socle/contrats/fiche/0.2.0",
  "title": "Fiche du catalogue (contrat 0.2.0, arbre/conception/contrats/fiche-catalogue.md)",
  "type": "object",
  "required": ["id", "kind", "name", "status", "provenance"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^holarch:[a-z_]+:.+" },
    "kind": { "type": "string", "pattern": "^[a-z_]+$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": ["string", "null"] },
    "version": { "type": ["string", "null"] },
    "node": { "type": ["string", "null"] },
    "context": { "type": ["string", "null"] },
    "status": { "enum": ["proposed", "active", "suspended", "retired"] },
    "provenance": {
      "type": "object",
      "required": ["source"],
      "properties": { "source": { "type": "string" }, "created_by": { "type": "string" }, "at": { "type": "string" } }
    },
    "license": { "type": ["string", "null"] },
    "shareable": { "type": "boolean" },
    "classification": { "enum": ["public", "internal", "confidential", "sensitive"] },
    "site": { "type": ["string", "null"] },
    "location": { "type": ["string", "null"] },
    "usage": {
      "type": "object",
      "properties": { "count": { "type": "integer" }, "last_used": { "type": ["string", "null"] }, "cost_usd": { "type": ["number", "null"] } }
    },
    "links": { "type": "object" },
    "attributes": { "type": "object", "description": "Attributs propres au kind (par adaptateur), non normatifs." }
  }
}
